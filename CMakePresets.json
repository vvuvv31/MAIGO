{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-debug",
      "displayName": "CPU debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CARBON_ENABLE_SYCL": "OFF",
        "CARBON_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "oneapi-release",
      "displayName": "Intel oneAPI SYCL release (Linux dual: Intel SPIR-V + NVIDIA CUDA)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_SYCL_TARGETS": "spir64,nvptx64-nvidia-cuda",
        "CARBON_ENABLE_MINIBEAM": "OFF"
      }
    },
    {
      "name": "oneapi-nvidia-release",
      "displayName": "Intel oneAPI SYCL release (NVIDIA CUDA AOT)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-nvidia-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_ENABLE_MINIBEAM": "OFF",
        "CARBON_SYCL_TARGETS": "nvptx64-nvidia-cuda"
      }
    },
    {
      "name": "oneapi-nvidia-minibeam",
      "displayName": "Intel oneAPI SYCL release (NVIDIA + minibeam ON)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-nvidia-minibeam",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_ENABLE_MINIBEAM": "ON",
        "CARBON_SYCL_TARGETS": "nvptx64-nvidia-cuda"
      }
    },
    {
      "name": "oneapi-intel-release",
      "displayName": "Intel oneAPI SYCL release (Intel SPIR-V only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-intel-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_SYCL_TARGETS": "spir64"
      }
    },
    {
      "name": "oneapi-windows-release",
      "displayName": "Intel oneAPI SYCL release (Windows/Arc GPU, SPIR-V)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icx-cl",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_SYCL_TARGETS": "spir64"
      }
    },
    {
      "name": "oneapi-windows-dual-release",
      "displayName": "Intel oneAPI SYCL release (Windows Arc + NVIDIA; needs CUDA toolkit)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/oneapi-windows-dual-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icx-cl",
        "CARBON_ENABLE_SYCL": "ON",
        "CARBON_BUILD_TESTS": "ON",
        "CARBON_SYCL_TARGETS": "spir64,nvptx64-nvidia-cuda"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "oneapi-release",
      "configurePreset": "oneapi-release"
    },
    {
      "name": "oneapi-nvidia-release",
      "configurePreset": "oneapi-nvidia-release"
    },
    {
      "name": "oneapi-nvidia-minibeam",
      "configurePreset": "oneapi-nvidia-minibeam"
    },
    {
      "name": "oneapi-intel-release",
      "configurePreset": "oneapi-intel-release"
    },
    {
      "name": "oneapi-windows-release",
      "configurePreset": "oneapi-windows-release"
    },
    {
      "name": "oneapi-windows-dual-release",
      "configurePreset": "oneapi-windows-dual-release"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-release",
      "configurePreset": "oneapi-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-nvidia-release",
      "configurePreset": "oneapi-nvidia-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-nvidia-minibeam",
      "configurePreset": "oneapi-nvidia-minibeam",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-intel-release",
      "configurePreset": "oneapi-intel-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-windows-release",
      "configurePreset": "oneapi-windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "oneapi-windows-dual-release",
      "configurePreset": "oneapi-windows-dual-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
