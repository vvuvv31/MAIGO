# Thin pure-isotope target for correlated C-12 inelastic event libraries.
# 1 mm slab: primary energy is essentially the reaction energy (FRED 95 MeV/u analog).
i:Ts/Seed = @SEED@
i:Ts/NumberOfThreads = @THREADS@
i:Ts/ShowHistoryCountAtInterval = 50000
b:Gr/Enable = "False"

i:Is/H1/Z = 1
i:Is/H1/N = 1
d:Is/H1/A = 1.00782503223 g/mole
i:Is/C12/Z = 6
i:Is/C12/N = 12
d:Is/C12/A = 12.0 g/mole
i:Is/O16/Z = 8
i:Is/O16/N = 16
d:Is/O16/A = 15.99491461957 g/mole

s:El/HydrogenH1/Symbol = "H"
sv:El/HydrogenH1/IsotopeNames = 1 "H1"
uv:El/HydrogenH1/IsotopeAbundances = 1 1.0
s:El/CarbonC12/Symbol = "C"
sv:El/CarbonC12/IsotopeNames = 1 "C12"
uv:El/CarbonC12/IsotopeAbundances = 1 1.0
s:El/OxygenO16/Symbol = "O"
sv:El/OxygenO16/IsotopeNames = 1 "O16"
uv:El/OxygenO16/IsotopeAbundances = 1 1.0

d:Ma/TargetH1/Density = 1.0 g/cm3
s:Ma/TargetH1/State = "Liquid"
sv:Ma/TargetH1/Components = 1 "HydrogenH1"
uv:Ma/TargetH1/Fractions = 1 1.0
d:Ma/TargetC12/Density = 2.0 g/cm3
s:Ma/TargetC12/State = "Solid"
sv:Ma/TargetC12/Components = 1 "CarbonC12"
uv:Ma/TargetC12/Fractions = 1 1.0
d:Ma/TargetO16/Density = 1.0 g/cm3
s:Ma/TargetO16/State = "Liquid"
sv:Ma/TargetO16/Components = 1 "OxygenO16"
uv:Ma/TargetO16/Fractions = 1 1.0

s:Ge/World/Type = "TsBox"
s:Ge/World/Material = "G4_Galactic"
d:Ge/World/HLX = 200 mm
d:Ge/World/HLY = 200 mm
d:Ge/World/HLZ = 50 mm
b:Ge/World/Invisible = "TRUE"

s:Ge/Phantom/Parent = "World"
s:Ge/Phantom/Type = "TsBox"
s:Ge/Phantom/Material = "@TARGET_MATERIAL@"
d:Ge/Phantom/HLX = 50 mm
d:Ge/Phantom/HLY = 50 mm
d:Ge/Phantom/HLZ = 0.5 mm
d:Ge/Phantom/MaxStepSize = 0.1 mm

s:Ge/BeamPosition/Parent = "World"
s:Ge/BeamPosition/Type = "Group"
d:Ge/BeamPosition/TransZ = 1.5 mm

s:So/IonBeam/Type = "Beam"
s:So/IonBeam/Component = "BeamPosition"
s:So/IonBeam/BeamParticle = "GenericIon(6,12)"
d:So/IonBeam/BeamEnergy = @TOTAL_ENERGY_MEV@ MeV
u:So/IonBeam/BeamEnergySpread = 0.0
s:So/IonBeam/BeamPositionDistribution = "None"
s:So/IonBeam/BeamAngularDistribution = "None"
i:So/IonBeam/NumberOfHistoriesInRun = @HISTORIES@

s:Ph/ListName = "Default"
s:Ph/Default/Type = "Geant4_Modular"
sv:Ph/Default/Modules = 7 "g4em-standard_opt4" "g4h-phy_QGSP_BIC_HP" "g4decay" "g4ion-inclxx" "g4h-elastic_HP" "g4stopping" "g4radioactivedecay"
d:Ph/Default/CutForAllParticles = 0.05 mm

s:Sc/CarbonReaction/Quantity = "CarbonReactionNtuple"
s:Sc/CarbonReaction/Component = "Phantom"
s:Sc/CarbonReaction/OutputType = "ASCII"
s:Sc/CarbonReaction/OutputFile = "@OUTPUT_STEM@_reactions"
s:Sc/CarbonReaction/IfOutputFileAlreadyExists = "Overwrite"

s:Sc/CarbonCascade/Quantity = "CarbonCascadeNtuple"
s:Sc/CarbonCascade/Component = "Phantom"
s:Sc/CarbonCascade/OutputType = "ASCII"
s:Sc/CarbonCascade/OutputFile = "@OUTPUT_STEM@_cascade"
s:Sc/CarbonCascade/IfOutputFileAlreadyExists = "Overwrite"

s:Sc/CarbonNeutral/Quantity = "CarbonNeutralNtuple"
s:Sc/CarbonNeutral/Component = "Phantom"
s:Sc/CarbonNeutral/OutputType = "ASCII"
s:Sc/CarbonNeutral/OutputFile = "@OUTPUT_STEM@_neutral"
s:Sc/CarbonNeutral/IfOutputFileAlreadyExists = "Overwrite"
