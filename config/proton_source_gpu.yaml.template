# Non-minibeam proton GPU template. Replace every @...@ with validated package paths/hashes.
# Uses existing binary schemas; this file is not runnable until new data are supplied.
run_mode: research
scorer_mode: production
unified_water_material_file: data/water_unified/g4_water_material.json
unified_water_material_sha256: 60be17929880fe18f1758edc02350b3fa7140b817ab0d21cb75bd87dbc891f31
enable_ct_grid: false
number_of_histories: 10000
initial_energy_MeV: 150
primary_particle: proton
beam_energy_spread: 0.01
random_seed: 202609071
water_density_g_per_cm3: 1.0
phantom_length_mm: 200
maximum_step_mm: 0.25
maximum_relative_energy_loss: 0.005
energy_cutoff_MeV: 0.1
enable_voxel_scoring: true
voxel_bins_x: 64
voxel_bins_y: 64
voxel_bins_z: 400
voxel_size_x_mm: 2.0
voxel_size_y_mm: 2.0
voxel_size_z_mm: 0.5
depth_bin_width_mm: 0.5
scorer_area_mm2: 16384
enable_multiple_scattering: true
multiple_scattering_model: highland
fermi_eyges_species: all
fermi_eyges_parameter_set: species_water
fermi_eyges_max_segment_mm: 0.1
enable_inelastic: true
nuclear_model: geant4
enable_secondary_transport: true
cinel02_max_secondary_inelastic_generations: 2
secondary_out_of_scope_nuclear_policy: em_only
primary_stopping_power_file: @PROTON_WATER_STOPPING_CSV@
use_particle_specific_stopping_power: true
particle_stopping_power_file: @ION_WATER_STOPPING_CSV@
ct_schneider_primary_rate_file: @PROTON_PRIMARY_RATE@
ct_schneider_primary_cinel03_file: @PROTON_PRIMARY_CINEL03@
ct_schneider_secondary_rate_file: @SECONDARY_RATE@
ct_schneider_secondary_cinel03_file: @SECONDARY_CINEL03@
ct_schneider_stopping_power_file: @PROTON_SCHNEIDER_STOPPING@
ct_schneider_physics_bundle_file: @PROTON_PHYSICS_BUNDLE@
max_device_memory_fraction: 0.8
dose_to_medium: true
dose_to_medium_type: mhd
dose_to_medium_name: dose
LET: false
device: cuda

# User-accepted condensed delta + Poisson partition mean correction (2026-09-15).
em_model: g4_material_joint_v1
em_delta_moments_file: @EM_DELTA_MOMENTS@
em_package_file: @EM_PACKAGE@
em_package_sha256: @EM_SHA256@
primary_em_model: legacy
enable_energy_straggling: true
enable_secondary_energy_straggling: true
straggling_scale: 1.0
ct_secondary_exact_faces: true
history_chunk_size: 10000

# Species scheduling authorized; dose equivalence investigation remains open.
enable_secondary_unified_em: true
secondary_species_grouping: true
# Compact survivors after 16 complete steps; queues below 8192 finish directly.
secondary_step_chunking: true

em_delta_moments_sha256: @DELTA_MOMENTS_SHA256@
em_delta_moments_source_sha256: @EM_SHA256@

