# Template for the water-only proton validation campaign. Render it with
# scripts/prepare_proton_water_configs.py; do not point carbon runs at these
# packages.
number_of_histories: @HISTORIES@
initial_energy_MeVu: @ENERGY_MEV@
primary_atomic_number: 1
primary_mass_number: 1
primary_rest_mass_MeV: 938.27208816
phantom_length_mm: 350.0
depth_bin_width_mm: 0.5
maximum_step_mm: 0.1
maximum_relative_energy_loss: 0.005
energy_cutoff_MeV: 0.1
water_density_g_per_cm3: 1.0
scorer_area_mm2: 90000.0
enable_voxel_scoring: true
enable_charged_origin_voxel_scoring: false
enable_energy_straggling: true
enable_multiple_scattering: true
enable_primary_attenuation: true
enable_primary_elastic_interactions: true
enable_secondary_generation: true
enable_secondary_transport: true
enable_fragment_cascade: true
enable_neutral_transport: false
maximum_cascade_generations: 2
secondary_queue_capacity: 500000
max_device_memory_fraction: 0.50
random_seed: @GPU_SEED@
primary_stopping_power_file: @STOPPING_POWER@
primary_inelastic_cross_section_file: @INELASTIC_XS@
primary_elastic_cross_section_file: data/proton_water_direct_elastic_xs.csv
primary_reaction_package_file: @PRIMARY_PACKAGE@
cascade_package_file: @CASCADE_PACKAGE@
primary_elastic_package_file: data/packages/proton_water_hadelastic_10k_x5_plus_low_final.bin
primary_elastic_package_physics_model: G4HadronElasticPhysicsHP
package_identity_validation: strict
primary_package_physics_model: QGSP_BIC_HP/BinaryCascade
cascade_package_physics_model: QGSP_BIC_HP/BinaryCascade
# This remains off unless an independently measured correction table is
# present. The table has header initial_energy_MeV_per_u,primary_inelastic_xs_scale.
enable_primary_inelastic_xs_correction: @ENABLE_XS_CORRECTION@
primary_inelastic_xs_correction_file: @XS_CORRECTION@
output_file: @OUTPUT_DIR@/dose_MeV.csv
fragment_species_output_file: @OUTPUT_DIR@/species_dose_MeV.csv
let_output_file: @OUTPUT_DIR@/letd.csv
scorerLET: true
scorer_mode: validation
validation_output_directory: @OUTPUT_DIR@
device: gpu
