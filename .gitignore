# Build / runtime
build/
build-*/
out/
*.log
*.vtk
*.root
__pycache__/
*.pyc

# Patient DICOM contains private source images and remains local. Derived CT
# grids and their conversion metadata are required runtime inputs and are
# versioned (large binaries use Git LFS via .gitattributes).
ct/dicom/

tmp/
# ---------------------------------------------------------------------------
# Monte Carlo run outputs (TOPAS + GPU) — never commit
# ---------------------------------------------------------------------------
# GPU IDDs, TOPAS references, metrics, plots, reaction/cascade packages, etc.
validation/results/**
!validation/results/.gitkeep
# Keep only short human docs (how to regenerate), not run data
!validation/results/**/*.md
# Runtime physics databases and their reproducibility metadata/source tables.
!validation/results/topas_200MeVu_cascade_100k*
!validation/results/topas_200MeVu_cascade_aligned_primary*
!validation/results/topas_200MeVu_neutral_development*

# TOPAS raw scorer dumps
validation/topas/output/**
!validation/topas/output/.gitkeep
!validation/topas/output/ct_patient_development_energy_deposit.csv

# Local session / agent clutter
mcps/
